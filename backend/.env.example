PORT=5000

DATABASE_URL=postgresql://username:password@localhost:5432/trigger10x
# Optional: explicitly control DB SSL if needed (defaults to false for localhost)
# DB_SSL=false

# List production domains and local dev ports separated by commas
FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com,http://localhost:5500,http://127.0.0.1:5500

ADMIN_EMAIL=your-admin-email@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-16-letter-app-password
SMTP_FROM=TRIGGER10X Website <your-email@example.com>

ADMIN_API_KEY=replace-with-a-long-random-secret